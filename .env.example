# ─── Faucet drip policy ─────────────────────────────────────────────
# Amount of TAZ sent per successful claim.
FAUCET_DRIP_TAZ=0.1
# Cooldown before the same address OR client can claim again (seconds). 86400 = 24h.
FAUCET_COOLDOWN_SECONDS=86400
# Optional hard daily cap on total TAZ dispensed by the faucet (safety valve).
# This is the spoof-proof ceiling on total drain — set it deliberately.
FAUCET_DAILY_CAP_TAZ=100
# Number of reverse proxies YOU run in front of the app (nginx/Cloudflare/Vercel
# = usually 1). X-Forwarded-For is only trusted for this many hops from the right;
# 0 means don't trust it at all (per-IP limiting is skipped). Setting this too
# high re-opens the rate-limit-bypass hole, so match your real topology.
TRUSTED_PROXY_COUNT=0
# Reserve floor: keep this much TAZ untouched. Below drip+reserve the faucet
# reports "empty" instead of sending. 0 = dispense down to the last drip.
FAUCET_MIN_RESERVE_TAZ=0
# Max sends waiting in the serial FIFO queue before new requests get "busy" (503).
SEND_QUEUE_MAX_PENDING=20

# ─── Privacy ────────────────────────────────────────────────────────
# Salt for hashing client IPs (we never store raw IPs). Set to a long random
# secret in production so the fingerprints aren't reversible.
RATE_LIMIT_SALT=change-me-to-a-random-secret

# ─── Backend: public lightwalletd / Zaino testnet endpoint(s) ───────
# One or more gRPC endpoints serving the Zcash Light Client Protocol on TESTNET,
# comma-separated. Tried in order — the first reachable one is used (failover).
# For a decentralized deploy, point this at your OWN Zebra + Zaino/lightwalletd.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443,https://lightwalletd.testnet.electriccoin.co:9067
# Which sender adapter to use: "mock" (runs with no keys, fake txids) or "webzjs".
FAUCET_SENDER=mock
# Simulated spendable balance for mock mode, so the low-balance guard is testable.
FAUCET_MOCK_BALANCE_TAZ=10

# ─── Faucet wallet secret (ONLY needed for the real "webzjs" sender) ─
# Unified spending key / seed for the faucet's TESTNET wallet. NEVER commit this.
# Leave blank when FAUCET_SENDER=mock.
FAUCET_WALLET_SEED=
# Public receive address shown on the Donate tab (so people can refill the faucet).
FAUCET_DONATION_ADDRESS=

# ─── Cloudflare Turnstile (anti-abuse) ──────────────────────────────
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable the CAPTCHA check in local dev.
# For a fully self-sovereign deploy, swap Turnstile for a PoW challenge instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
