# ─── Faucet drip policy ─────────────────────────────────────────────
# Amount of TAZ sent per successful claim.
FAUCET_DRIP_TAZ=0.1
# Cooldown before the same address OR client can claim again (seconds). 86400 = 24h.
FAUCET_COOLDOWN_SECONDS=86400
# Optional hard daily cap on total TAZ dispensed by the faucet (safety valve).
# This is the spoof-proof ceiling on total drain — set it deliberately.
FAUCET_DAILY_CAP_TAZ=100
# Number of reverse proxies YOU run in front of the app (nginx/Cloudflare/Vercel
# = usually 1). X-Forwarded-For is only trusted for this many hops from the right;
# 0 means don't trust it at all (per-IP limiting is skipped). Setting this too
# high re-opens the rate-limit-bypass hole, so match your real topology.
TRUSTED_PROXY_COUNT=0
# Reserve floor: keep this much TAZ untouched. Below drip+reserve the faucet
# reports "empty" instead of sending. 0 = dispense down to the last drip.
FAUCET_MIN_RESERVE_TAZ=0
# Max sends waiting in the serial FIFO queue before new requests get "busy" (503).
SEND_QUEUE_MAX_PENDING=20

# ─── Ledger backend ─────────────────────────────────────────────────
# "sqlite" = local file (dev / single always-on box).
# "d1"     = Cloudflare D1 via the proxy Worker (worker/). Use this on hosts with
#            an ephemeral disk (e.g. Render free) so rate limits survive restarts.
DB_BACKEND=sqlite
# Only for DB_BACKEND=d1 — the deployed proxy Worker URL + its shared secret.
D1_PROXY_URL=
D1_PROXY_SECRET=

# ─── Privacy ────────────────────────────────────────────────────────
# Salt for hashing client IPs (we never store raw IPs). Set to a long random
# secret in production so the fingerprints aren't reversible.
RATE_LIMIT_SALT=change-me-to-a-random-secret

# ─── Backend: public lightwalletd / Zaino testnet endpoint(s) ───────
# One or more gRPC endpoints serving the Zcash Light Client Protocol on TESTNET,
# comma-separated. Tried in order — the first reachable one is used (failover).
# For a decentralized deploy, point this at your OWN Zebra + Zaino/lightwalletd.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443,https://lightwalletd.testnet.electriccoin.co:9067

# ─── Sender: mock / real / zallet ───────────────────────────────────
# "mock"   = fake txids, no keys, no coins move (demo / dev).
# "real"   = spends a funded TRANSPARENT testnet wallet (see below). Transparent
#            recipients get a plain tx; unified (utest1…) recipients get a
#            transparent→Orchard t2z tx. The faucet's balance + drip origins are
#            public, and Sapling-only recipients aren't supported.
# "zallet" = a genuinely SHIELDED faucet on the Z3 stack (zebrad + zallet). Holds
#            Orchard notes and pays z→z; faucet holdings and the faucet↔claimant
#            link stay private, and it can pay Sapling recipients too. Needs a
#            running `zallet start` — see the ZALLET_* block below and DEPLOY.md.
FAUCET_SENDER=mock
# Simulated spendable balance for mock mode, so the low-balance guard is testable.
FAUCET_MOCK_BALANCE_TAZ=10

# ─── Faucet wallet secret (required when FAUCET_SENDER=real) ─────────
# The funded TRANSPARENT testnet wallet's private key: a testnet WIF (starts 'c'
# or '9') or a 64-char hex key. Fund its tm… address from an existing faucet.
# NEVER commit this; set it in the host's secret store.
FAUCET_WALLET_SEED=
# Public receive address shown on the Donate tab (so people can refill the faucet).
FAUCET_DONATION_ADDRESS=

# ─── Zallet backend (required when FAUCET_SENDER=zallet) ─────────────
# A running `zallet start` (Z3 stack: zebrad + zallet-zaino) serves the wallet's
# JSON-RPC. See DEPLOY.md for standing up the node + wallet.
# JSON-RPC endpoint + HTTP Basic creds (a [[rpc.auth]] user in zallet.toml).
ZALLET_RPC_URL=http://127.0.0.1:28232/
ZALLET_RPC_USER=faucet
ZALLET_RPC_PASSWORD=
# The faucet's own account UUID (z_getnewaccount) and one of its unified
# addresses (z_getaddressforaccount) — the wallet spends from this account.
ZALLET_ACCOUNT=
ZALLET_ADDRESS=
# Confirmations a note needs before it's spendable (Zallet default 10; testnet
# can drop to 1 for faster demos).
ZALLET_MIN_CONF=10
# Only if the wallet is encrypted with a PASSPHRASE identity: unlocks it per send.
# Leave blank when using a plain on-disk age identity (the DEPLOY.md default).
ZALLET_PASSPHRASE=
ZALLET_UNLOCK_SECONDS=60
# A shielded build+prove can take tens of seconds; how long to wait for the opid.
ZALLET_OP_TIMEOUT_MS=180000
ZALLET_POLL_MS=1500
ZALLET_RPC_TIMEOUT_MS=15000

# ─── Cloudflare Turnstile (anti-abuse) ──────────────────────────────
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable the CAPTCHA check in local dev.
# For a fully self-sovereign deploy, swap Turnstile for a PoW challenge instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
