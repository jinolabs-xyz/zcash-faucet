#!/usr/bin/env bash
# Stub docker for deploy.sh tests. Containers are files under $STUB_CONTAINERS,
# line 1 = state (running|exited), line 2 = compose project label (may be
# empty, meaning hand-started). Every call logs to $STUB_LOG.
set -euo pipefail
echo "docker $*" >> "${STUB_LOG:?}"

mk() { printf '%s\n%s\n' "$2" "$3" > "${STUB_CONTAINERS:?}/$1"; }

# The wallet reads its config into memory at start. Copy the faucet's pwhash (or its
# pre-#176 plaintext password) into the "loaded" file, which is what the curl stub
# checks a credential against. Called ONLY on create and on restart, deliberately:
# `up -d` against an existing container reloads nothing, and modelling that is the
# whole point of this stub.
zallet_load_config() {
  [ -n "${STUB_ZALLET_LOADED:-}" ] || return 0
  # A wallet asked to restart that did not pick the new config up: the state production
  # was actually found in, so it has to be reachable from a test. Scoped to the RESTART
  # only ($1 = restart), because suppressing the initial load as well makes the wallet
  # simply unreachable, and the deploy then refuses for that reason instead, proving
  # something adjacent to what the test claims.
  if [ "${1:-}" = restart ] && [ "${STUB_ZALLET_IGNORE_RESTART:-0}" = "1" ]; then return 0; fi
  cfg="${STUB_ZALLET_CONFIG:-}"
  [ -n "$cfg" ] && [ -f "$cfg" ] || return 0
  val="$(sed -n 's/^[[:space:]]*pwhash[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg" | tail -n1)"
  [ -n "$val" ] || val="$(sed -n 's/^[[:space:]]*password[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg" | tail -n1)"
  printf '%s' "$val" > "$STUB_ZALLET_LOADED"
  echo "zallet-loaded-config" >> "${STUB_LOG:-/dev/null}"
}

case "${1:-}" in
  run)
    # One-off containers: docker run --rm -v <vol>:/data busybox <cmd> <args>
    shift
    vol=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -v) vol="${2%%:*}"; shift 2 ;;
        --rm|busybox) shift ;;
        *) break ;;
      esac
    done
    vdir="${STUB_VOLROOT:?}/$vol"
    mkdir -p "$vdir"   # docker run auto-creates named volumes
    cmd="${1:-}"; shift || true
    case "$cmd" in
      test)  [ "$1" = "-f" ] && { [ -f "$vdir/${2#/data/}" ]; exit $?; }; exit 64 ;;
      chown) echo "vol-chown $vol" >> "$STUB_LOG" ;;
      touch) touch "$vdir/${1#/data/}" ;;
      *) echo "stub docker run: unsupported: $cmd" >&2; exit 64 ;;
    esac
    ;;
  compose)
    shift
    # `docker compose version` (the capability probe at the top of deploy.sh)
    for a in "$@"; do [ "$a" = "version" ] && { echo "Docker Compose version v2-stub"; exit 0; }; done
    # run --rm --no-deps zallet <global flags> <subcommand>: the wallet init
    # one-offs. Mimic the real semantics tests care about.
    if printf '%s\n' "$@" | grep -qx "run"; then
      vdir="${STUB_VOLROOT:?}/z3-testnet-zallet"; mkdir -p "$vdir"
      sub=""
      for a in "$@"; do case "$a" in generate-encryption-identity|init-wallet-encryption|generate-mnemonic) sub="$a";; esac; done
      printf '%s\n' "$@" | grep -qx -- "--config" || { echo "stub: init missing --config" >&2; exit 1; }
      case "$sub" in
        generate-encryption-identity)
          # noclobber, like the real command
          [ -f "$vdir/identity.txt" ] && { echo "identity exists, refusing" >&2; exit 1; }
          echo stub-age-identity > "$vdir/identity.txt" ;;
        init-wallet-encryption)
          [ -f "$vdir/identity.txt" ] || { echo "Encryption identity file could not be located" >&2; exit 1; }
          echo stub-recipients > "$vdir/recipients.txt" ;;
        generate-mnemonic)
          # every invocation stores another seed, like the real command
          echo "seed-$(date +%s%N)" >> "$vdir/seeds" ;;
        *) echo "stub compose run: unknown subcommand" >&2; exit 64 ;;
      esac
      exit 0
    fi
    # exec ... rpc <method>: answer like zallet-zaino
    if printf '%s\n' "$@" | grep -qx "exec"; then
      method=""
      prev=""
      for a in "$@"; do [ "$prev" = "rpc" ] && { method="$a"; break; }; prev="$a"; done
      case "$method" in
        z_getnewaccount)        echo '{"account_uuid":"stub-uuid-1234"}' ;;
        z_getaddressforaccount) echo '{"address":"utest1stubaddress"}' ;;
        z_getbalanceforaccount) echo '{"pools":{}}' ;;
        *) echo "stub: unknown rpc $method" >&2; exit 1 ;;
      esac
      exit 0
    fi
    # compose ps -q <service>: the container id for one service. deploy.sh asks
    # by SERVICE rather than grepping container names, so the stub has to answer
    # the same way - see the faucet_status comment in deploy.sh.
    if printf '%s\n' "$@" | grep -qx "ps"; then
      svc=""; prev=""
      for a in "$@"; do [ "$prev" = "-q" ] && { svc="$a"; break; }; prev="$a"; done
      [ -n "$svc" ] || { echo "stub compose ps: expected -q <service>" >&2; exit 64; }
      # Silence, not an error, when the container does not exist: that is what
      # real compose does, and deploy.sh reads an empty id as cannot-tell.
      [ -f "${STUB_CONTAINERS:?}/zcash-faucet-$svc-1" ] && echo "zcash-faucet-$svc-1"
      exit 0
    fi
    # restart <service>: the ONLY thing besides creation that makes the wallet
    # re-read its config. deploy.sh has to use this rather than `up -d`.
    if printf '%s\n' "$@" | grep -qx "restart"; then
      for svc in zebra zallet; do
        if printf '%s\n' "$@" | grep -qx "$svc"; then
          [ -f "${STUB_CONTAINERS:?}/z3-testnet-$svc-1" ] || { echo "stub: no such service $svc to restart" >&2; exit 1; }
          echo "restart z3-testnet-$svc-1" >> "$STUB_LOG"
          if [ "$svc" = zallet ]; then zallet_load_config restart; fi
        fi
      done
      exit 0
    fi
    # up -d [services...]
    if printf '%s\n' "$@" | grep -qx "up"; then
      if printf '%s\n' "$@" | grep -qx "docker-compose.faucet.yml"; then
        # STUB_FAUCET_STATE models an app that will not stay up: deploy.sh must
        # not report success for it. A stub whose faucet is always `running`
        # could only ever prove the happy path, which is how #206 survived.
        mk zcash-faucet-faucet-1 "${STUB_FAUCET_STATE:-running}" zcash-faucet
        mk zcash-faucet-caddy-1  running zcash-faucet
        echo "overlay-up" >> "$STUB_LOG"
      else
        for svc in zebra zallet; do
          printf '%s\n' "$@" | grep -qx "$svc" || continue
          # Existed already? Then this is a no-op, exactly as real compose treats an
          # unchanged container spec, and the loaded config is left ALONE. That is the
          # production bug: a rewritten bind-mounted file does not change the spec.
          fresh=0
          [ -f "${STUB_CONTAINERS:?}/z3-testnet-$svc-1" ] || fresh=1
          mk "z3-testnet-$svc-1" running z3-testnet
          if [ "$fresh" = 1 ] && [ "$svc" = zallet ]; then zallet_load_config create; fi
        done
      fi
      exit 0
    fi
    echo "stub docker compose: unsupported: $*" >&2; exit 64
    ;;
  ps)
    shift
    name=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --filter) name="${2#name=}"; shift 2 ;;
        -aq|--format) shift ;;
        *) shift ;;
      esac
    done
    for f in "${STUB_CONTAINERS:?}"/*; do
      [ -e "$f" ] || continue
      c="$(basename "$f")"
      case "$c" in *"$name"*) echo "$c" ;; esac
    done
    ;;
  inspect)
    shift
    fmt=""; target=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) fmt="$2"; shift 2 ;;
        *) target="$1"; shift ;;
      esac
    done
    f="${STUB_CONTAINERS:?}/$target"
    [ -f "$f" ] || { echo "no such container: $target" >&2; exit 1; }
    case "$fmt" in
      *Labels*) sed -n 2p "$f" ;;
      *.Name*)  echo "/$target" ;;
      # Container env, for the "is this box already serving HTTPS" probe. Held in a
      # per-container variable rather than in the marker file, so existing fixtures keep
      # their two-line format and nothing has to be rewritten to add this.
      *Config.Env*)
        ev="STUB_ENV_$(printf '%s' "$target" | tr -c 'A-Za-z0-9' '_')"
        printf '%s\n' "${!ev:-}" | grep -v '^$' || true ;;
      # Line 1 may hold a SEQUENCE of states, consumed one per call, so a
      # container that flips between two reads is representable. A container in a
      # restart loop passes through `running`, so a single sample can land on the
      # good frame - with only one state available, a one-sample check and a
      # two-sample check are indistinguishable here and dropping the second
      # sample would stay green. The last state repeats once the list runs out.
      *State.Status*)
        states="$(sed -n 1p "$f")"
        set -- $states
        echo "$1"
        if [ $# -gt 1 ]; then
          shift
          { printf '%s\n' "$*"; sed -n '2,$p' "$f"; } > "$f.next" && mv "$f.next" "$f"
        fi
        ;;
      *) echo "stub inspect: unsupported fmt $fmt" >&2; exit 64 ;;
    esac
    ;;
  rm)
    shift
    [ "${1:-}" = "-f" ] && shift
    rm -f "${STUB_CONTAINERS:?}/$1"
    echo "$1"
    ;;
  *) echo "stub docker: unsupported: $*" >&2; exit 64 ;;
esac
