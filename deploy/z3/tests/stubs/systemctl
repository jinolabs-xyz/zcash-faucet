#!/usr/bin/env bash
# Stub systemctl: unit states are files under $STUB_SYSTEMD (active|inactive).
# STUB_WD_STUCK=1 makes `stop` silently fail to stop, for the guard test.
set -euo pipefail
echo "systemctl $*" >> "${STUB_LOG:?}"

args=()
for a in "$@"; do [ "$a" = "--quiet" ] || args+=("$a"); done
cmd="${args[0]}"; unit="${args[1]:-}"
state_file="${STUB_SYSTEMD:?}/$unit"

case "$cmd" in
  is-active)
    # Prints the WORD like the real one (unless --quiet), and exits 0 only for active:
    # auto-deploy reads the word, since inactive, failed and activating all exit 3.
    word="$([ -f "$state_file" ] && cat "$state_file" || echo inactive)"
    quiet=0; for a in "$@"; do [ "$a" = "--quiet" ] && quiet=1; done
    [ "$quiet" = "1" ] || echo "$word"
    [ "$word" = "active" ] && exit 0
    exit 3
    ;;
  stop)
    if [ "${STUB_WD_STUCK:-0}" = "1" ]; then exit 0; fi
    echo inactive > "$state_file"
    ;;
  start)
    # STUB_START_FAIL=1: the unit will not come up, for the "start FAILED pages" case.
    if [ "${STUB_START_FAIL:-0}" = "1" ]; then echo "Job for $unit failed." >&2; exit 1; fi
    echo active > "$state_file"
    ;;
  restart)
    # STUB_RESTART_FAIL=1: the restart is refused, for the "installed but not running" case.
    if [ "${STUB_RESTART_FAIL:-0}" = "1" ]; then echo "Job for $unit failed." >&2; exit 1; fi
    echo active > "$state_file"
    ;;
  *) echo "stub systemctl: unsupported: $*" >&2; exit 64 ;;
esac
