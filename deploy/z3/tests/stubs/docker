#!/usr/bin/env bash
# Stub docker: volumes are dirs under $STUB_VOLROOT, container states are
# files under $STUB_CONTAINERS (content: running|exited). Logs to $STUB_LOG.
set -euo pipefail
echo "docker $*" >> "${STUB_LOG:?}"

case "${1:-}" in
  volume)
    case "${2:-}" in
      inspect)
        shift 2
        fmt=""; vol=""
        while [ $# -gt 0 ]; do
          case "$1" in
            -f) fmt="$2"; shift 2 ;;
            *) vol="$1"; shift ;;
          esac
        done
        dir="${STUB_VOLROOT:?}/$vol"
        [ -d "$dir" ] || { echo "Error: no such volume: $vol" >&2; exit 1; }
        case "$fmt" in
          *Mountpoint*) echo "$dir" ;;
          *) echo "[{}]" ;;
        esac
        ;;
      create) mkdir -p "${STUB_VOLROOT:?}/$3"; echo "$3" ;;
      *) echo "stub docker: unsupported volume op: $*" >&2; exit 64 ;;
    esac
    ;;
  ps)
    shift
    name=""; all=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --filter) name="${2#name=}"; shift 2 ;;
        --format) shift 2 ;;
        -a|--all) all=1; shift ;;
        *) shift ;;
      esac
    done
    for f in "${STUB_CONTAINERS:?}"/*; do
      [ -e "$f" ] || continue
      c="$(basename "$f")"
      # -a means every state, which is the whole point of the flag: the watchdog
      # calls `ps -a` precisely so it can SEE a stopped or restarting container.
      # Honouring it only for 'running' made crash-loop behaviour untestable,
      # which is how 812 false recoveries shipped.
      if [ "$all" -eq 0 ]; then
        [ "$(head -n1 "$f")" = "running" ] || continue
      fi
      case "$c" in *"$name"*) echo "$c" ;; esac
    done
    ;;
  stop)
    shift
    [ "${1:-}" = "-t" ] && shift 2
    echo exited > "${STUB_CONTAINERS:?}/$1"
    echo "$1"
    ;;
  start)
    shift
    [ -f "${STUB_CONTAINERS:?}/$1" ] || { echo "no such container: $1" >&2; exit 1; }
    # A crash-looping container is the case the watchdog used to misread: the
    # start is ACCEPTED (exit 0) and the container still does not stay up. Name
    # it in STUB_CRASHLOOP to model that, because a stub where every start
    # succeeds can only ever prove the happy path.
    case " ${STUB_CRASHLOOP:-} " in
      *" $1 "*) echo restarting > "${STUB_CONTAINERS:?}/$1" ;;
      *)        echo running    > "${STUB_CONTAINERS:?}/$1" ;;
    esac
    echo "$1"
    ;;
  inspect)
    # Container inspect (the volume form is handled above). Only the state
    # format string is used, by faucet-metrics.sh.
    shift
    fmt=""; target=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) fmt="$2"; shift 2 ;;
        *) target="$1"; shift ;;
      esac
    done
    f="${STUB_CONTAINERS:?}/$target"
    [ -f "$f" ] || { echo "Error: No such object: $target" >&2; exit 1; }
    case "$fmt" in
      *State.Status*) head -n1 "$f" ;;
      *) echo "stub docker inspect: unsupported fmt $fmt" >&2; exit 64 ;;
    esac
    ;;
  logs)
    # docker logs [--tail N] <container>. Content is whatever a test wrote to the
    # container's .logs file, so the poison heal can be driven by modelling the -5
    # signature (or its absence). No file means empty logs, which is the healthy case and
    # keeps every existing suite - none of which write a .logs file - unchanged.
    shift
    target=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --tail) shift 2 ;;
        -f|--follow|-t|--timestamps) shift ;;
        *) target="$1"; shift ;;
      esac
    done
    lf="${STUB_CONTAINERS:?}/$target.logs"
    [ -f "$lf" ] && cat "$lf"
    exit 0
    ;;
  restart)
    shift
    [ -f "${STUB_CONTAINERS:?}/$1" ] || { echo "no such container: $1" >&2; exit 1; }
    echo running > "${STUB_CONTAINERS:?}/$1"
    echo "$1"
    ;;
  exec)
    # docker exec <container> ... : the only exec in the stack is the watchdog asking
    # zebra's JSON-RPC for getblockchaininfo. Answer from STUB_ZEBRA_BLOCKS and
    # STUB_ZEBRA_EST. STUB_ZEBRA_ADVANCE=1 raises blocks by one per call through a counter
    # file, so a "syncing" node advances across the sweeps of one run. STUB_ZEBRA_BLOCKS
    # unset models an RPC that will not answer, which keeps every suite that never set it
    # exactly as it was.
    [ -n "${STUB_ZEBRA_BLOCKS:-}" ] || exit 1
    b="$STUB_ZEBRA_BLOCKS"
    if [ "${STUB_ZEBRA_ADVANCE:-0}" = "1" ]; then
      cf="${STUB_ZEBRA_COUNTER:?}"
      n=0; [ -f "$cf" ] && n="$(cat "$cf")"
      n=$((n + 1)); echo "$n" > "$cf"
      # STUB_ZEBRA_STUCK_CALLS=K holds the tip for the first K calls, then advances: a node
      # that is wedged and then recovers, which is the shape a one-report heal needs.
      stuck="${STUB_ZEBRA_STUCK_CALLS:-0}"
      if [ "$n" -gt "$stuck" ]; then b=$((b + n - stuck)); fi
    fi
    printf '{"result":{"chain":"test","blocks":%s,"estimatedheight":%s},"error":null,"id":"watchdog"}\n' "$b" "${STUB_ZEBRA_EST:-$b}"
    ;;
  *) echo "stub docker: unsupported: $*" >&2; exit 64 ;;
esac
