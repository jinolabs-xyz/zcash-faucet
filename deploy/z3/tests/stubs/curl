#!/usr/bin/env bash
# Stub curl for the export script's ready gate. STUB_READY=0 simulates a
# node that is not ready. Everything else falls through to the real curl.
echo "curl $*" >> "${STUB_LOG:?}"
case "$*" in
  *"/ready"*)
    # STUB_CURL_RC: the transport failed with this curl status (6 DNS, 7 refused, 28
    # timeout, 35 TLS handshake...), no body, no HTTP status. Only the readiness fetch,
    # so the alert and health probes in the same sweep are untouched.
    [ -n "${STUB_CURL_RC:-}" ] && exit "$STUB_CURL_RC"
    # STUB_READY_FAIL_UNTIL names a marker: fail once, then pass, which is how
    # a node lagging a couple of blocks behaves.
    if [ -n "${STUB_READY_FAIL_UNTIL:-}" ] && [ ! -e "$STUB_READY_FAIL_UNTIL" ]; then
      touch "$STUB_READY_FAIL_UNTIL"; exit 22
    fi
    # Two conventions, because two callers differ and only one was modelled here.
    # zsnap's gate uses -f, where an HTTP error is exit 22 and the body is discarded.
    # watchdog.sh now uses -sS with -w '%{http_code}', where curl exits 0 and prints
    # the body and the status, so a 503 is an ANSWER and its reason survives.
    #
    # With only the -f form modelled, the watchdog's rewrite read a READY faucet as
    # not-ready under the suite: it got exit 0 but no status to match on. That was
    # invisible because the ready-grace window is long enough that nothing paged.
    # Same gap that made redeploy-curl unable to express any of this (#229).
    want_code=200
    [ "${STUB_READY:-1}" = "1" ] || want_code=503
    # STUB_READY_SEQUENCE="0 0 1 0": readiness per CALL, one value each, the last one
    # repeating, counted in a file beside the log. For an episode that recovers and
    # relapses inside one watchdog process.
    if [ -n "${STUB_READY_SEQUENCE:-}" ]; then
      cf="${STUB_LOG}.ready-count"
      n=$(( $(cat "$cf" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$cf"
      v=1; i=0
      for x in $STUB_READY_SEQUENCE; do i=$((i + 1)); v="$x"; [ "$i" -ge "$n" ] && break; done
      if [ "$v" = "1" ]; then want_code=200; else want_code=503; fi
    fi
    # STUB_READY_CANBUILD=0: a 200 whose send gate refuses (canBuildTx:false, tip
    # unverifiable), the shape the watchdog must page on. STUB_READY_CANBUILD_ONCE names
    # a marker: refuse on the first call only, so a recovery can be observed.
    canbuild="${STUB_READY_CANBUILD:-1}"
    if [ -n "${STUB_READY_CANBUILD_ONCE:-}" ] && [ ! -e "$STUB_READY_CANBUILD_ONCE" ]; then
      touch "$STUB_READY_CANBUILD_ONCE"; canbuild=0
    fi
    # The node block's heights, for the watchdog's step 7: STUB_READY_EXTERNAL is the
    # independent tip the body carries (empty: the field is absent, as when the oracle
    # is dark); STUB_READY_EXTERNAL=zebra-est copies STUB_ZEBRA_EST, i.e. the network
    # agrees with zebra's own estimate, which is what every pre-existing stall case
    # assumed before the watchdog started asking.
    ext="${STUB_READY_EXTERNAL:-}"
    [ "$ext" = "zebra-est" ] && ext="${STUB_ZEBRA_EST:-}"
    # ONE HEIGHT, TWO FIELDS, AND THE STUB NOW ENFORCES IT. The app computes both from
    # referenceTip(): `externalHeight` (nodeStatus.ts) and `usedHeight` (externalTip.ts) are
    # the same number by construction, the highest non-stale reference. This stub could set
    # them apart, and that is how the watchdog's step 7 came to be tested for a whole round
    # against an uncorroborated `externalHeight` the app would never publish without also
    # publishing `corroborated:false` beside it. The same trap the shapes below were written
    # to close, one field over.
    # A HEIGHT IS NOT A CORROBORATED HEIGHT, and the stub will not quietly turn one into the
    # other. An earlier cut of this had STUB_READY_EXTERNAL imply an `agree` shape so the old
    # step-7 cases kept working unchanged; that put a tipReferences block into the two cases
    # whose whole subject is a body WITHOUT one, and their premise died silently. A case that
    # wants step 7 to see an independent tip now says which corroboration shape it means,
    # which is the axis the rung actually turns on.
    # THE tipReferences BLOCK, for the watchdog's step 8 (R-12). FIVE SHAPES, and only the
    # five the app can actually produce - a stub that can express `corroborated:true` beside
    # a null `usedHeight` lets a test assert behaviour for a body that cannot exist, which
    # is worse than not covering it. STUB_READY_REFS:
    #   agree    two fresh sources 1 apart, corroborated true,  usedHeight = STUB_READY_USEDHEIGHT
    #   disagree two fresh sources far apart, corroborated false, usedHeight = the higher one
    #   single   one fresh source, corroborated NULL (one source is not agreement)
    #   none     nothing usable: sources {}, used null, usedHeight null, corroborated null
    #   stale    ANSWERED BUT NOT TRUSTED: one source keeps the height it last had, `stale`
    #            true, and `used`/`usedHeight` are null because nothing is usable. This is the
    #            state that separates a LAGGING reference from a DARK one, and until now no
    #            shape could express it - every other shape hard-codes stale:false, so a height
    #            and an unusable reference could never appear together (SDE-UI, review of #631).
    #            STUB_READY_USEDHEIGHT is the height the stale source still carries; nothing is
    #            usable, so it does NOT become usedHeight.
    #   absent   no tipReferences field at all, as a body from before #559 (the default)
    refs=""
    # EVERY SHAPE CARRIES THE TIME FIGURES TOO (#600 step 3). The app has emitted spreadSeconds
    # and secondsPerBlock on every body since #651 - the double did not, so a reader of the
    # deciding unit could be tested only against a body the app stopped producing. The two-source
    # shapes reconcile: blocks x rate is the seconds, because publishing three figures that do
    # not multiply out is the bug #651's own review found in the app.
    #
    # #651: the tolerance the app is APPLYING right now, flat beside usedHeight. Unset = the field
    # is absent, which is the pre-#651 body and must leave the watchdog on its own floor.
    agreeb=""
    [ -n "${STUB_READY_AGREE_BLOCKS:-}" ] && agreeb=",\"agreeBlocks\":${STUB_READY_AGREE_BLOCKS}"
    uh="${STUB_READY_USEDHEIGHT:-}"
    # STUB_READY_EXTERNAL ALONE MEANS "THE NETWORK AGREES AND IS AT N", which is what every
    # case written before the corroboration axis existed meant by it, and what step 7 needs
    # now that it reads the gate rather than the raw field. A case that wants the other
    # shapes says so with STUB_READY_REFS.
    # zebra-est here means the same as it does for STUB_READY_EXTERNAL: the network agrees
    # with zebra's own estimate, which is what every case assumes unless it says otherwise.
    [ "$uh" = "zebra-est" ] && uh="${STUB_ZEBRA_EST:-}"
    # STUB_READY_REFS_SEQ="agree disagree agree": the reference SHAPE per call, same
    # one-value-each-last-repeating rule as the other two sequences. A cannot-tell sweep
    # between two forks is the only way to test WHERE the once-per-episode flag resets.
    shape="${STUB_READY_REFS:-absent}"
    if [ -n "${STUB_READY_REFS_SEQ:-}" ]; then
      rcf="${STUB_LOG}.refs-count"
      rn=$(( $(cat "$rcf" 2>/dev/null || echo 0) + 1 )); echo "$rn" > "$rcf"
      ri=0
      for x in $STUB_READY_REFS_SEQ; do ri=$((ri + 1)); shape="$x"; [ "$ri" -ge "$rn" ] && break; done
    fi
    # STUB_READY_USEDHEIGHT_SEQ="4350000 4350300": the reference height per CALL, one value
    # each with the last repeating, modelled on STUB_READY_SEQUENCE above. For an episode
    # that ends and begins again inside ONE watchdog process, which is the only way to see
    # whether a once-per-episode page can ever fire a second time.
    if [ -n "${STUB_READY_USEDHEIGHT_SEQ:-}" ]; then
      ucf="${STUB_LOG}.usedheight-count"
      un=$(( $(cat "$ucf" 2>/dev/null || echo 0) + 1 )); echo "$un" > "$ucf"
      ui=0
      for x in $STUB_READY_USEDHEIGHT_SEQ; do ui=$((ui + 1)); uh="$x"; [ "$ui" -ge "$un" ] && break; done
    fi
    case "$shape" in
      absent) refs="" ;;
      agree)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=agree needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null},\"lightwalletd\":{\"height\":$((uh - 1)),\"ageSeconds\":9,\"stale\":false,\"host\":\"lwd\"}},\"spreadBlocks\":1,\"spreadSeconds\":11,\"secondsPerBlock\":10.5,\"corroborated\":true,\"used\":\"hosh\",\"usedHeight\":${uh},\"hoshHeight\":${uh},\"lightwalletdHeight\":$((uh - 1))}" ;;
      disagree)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=disagree needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null},\"lightwalletd\":{\"height\":$((uh - 400)),\"ageSeconds\":9,\"stale\":false,\"host\":\"lwd\"}},\"spreadBlocks\":400,\"spreadSeconds\":4200,\"secondsPerBlock\":10.5,\"corroborated\":false,\"used\":\"hosh\",\"usedHeight\":${uh},\"hoshHeight\":${uh},\"lightwalletdHeight\":$((uh - 400))}" ;;
      single)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=single needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null}},\"spreadBlocks\":null,\"spreadSeconds\":null,\"secondsPerBlock\":null,\"corroborated\":null,\"used\":\"hosh\",\"usedHeight\":${uh},\"hoshHeight\":${uh},\"lightwalletdHeight\":null}" ;;
      stale)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=stale needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":900,\"stale\":true,\"host\":null}},\"spreadBlocks\":null,\"spreadSeconds\":null,\"secondsPerBlock\":null,\"corroborated\":null,\"used\":null,\"usedHeight\":null,\"hoshHeight\":${uh},\"lightwalletdHeight\":null}" ;;
      none)
        refs=",\"tipReferences\":{\"sources\":{},\"spreadBlocks\":null,\"spreadSeconds\":null,\"secondsPerBlock\":null,\"corroborated\":null,\"used\":null,\"usedHeight\":null,\"hoshHeight\":null,\"lightwalletdHeight\":null}" ;;
      *) echo "stub curl: unsupported reference shape: $shape" >&2; exit 64 ;;
    esac
    # AND THE NODE BLOCK'S externalHeight COMES OFF THE SAME SHAPE, so the two fields cannot
    # contradict each other. `single` and `disagree` DO carry one - the app publishes the
    # highest fresh reference whether or not the sources agree, which is the entire reason
    # step 7 had to stop reading it - while `none` carries nothing to publish.
    heights=""
    case "$shape" in
      agree|disagree|single) [ -n "$uh" ] && heights=",\"nodeHeight\":${STUB_ZEBRA_BLOCKS:-0},\"externalHeight\":${uh}" ;;
      none) heights="" ;;
      absent) [ -n "$ext" ] && heights=",\"nodeHeight\":${STUB_ZEBRA_BLOCKS:-0},\"externalHeight\":${ext}" ;;
    esac
    # THE REFERENCE BLOCK FOR THE HISTORY HALF (#533 step 2), FLAT and top-level beside the
    # others, because that is the contract the watchdog parses with sed - `sources[...]` two
    # levels down is the #391 trap that `usedHeight` exists to avoid. Both knobs or neither: a
    # height with no hash is a body the app would never publish, and a stub that can express an
    # impossible body lets a test assert behaviour for a state that cannot happen.
    refblock=""
    if [ -n "${STUB_READY_REFHEIGHT:-}" ] || [ -n "${STUB_READY_REFHASH:-}" ]; then
      if [ -z "${STUB_READY_REFHEIGHT:-}" ] || [ -z "${STUB_READY_REFHASH:-}" ]; then
        echo "stub curl: STUB_READY_REFHEIGHT and STUB_READY_REFHASH go together" >&2; exit 64
      fi
      # THE SHAPE THE APP ACTUALLY PUBLISHES (#700, ready/route.ts -> forkReference), not the flat
      # pair this stub emitted until 2026-09-20. The stub encoded a contract the app never shipped,
      # so four cases passed against a body production has never produced while the rung they cover
      # had never once run. A double that agrees with the test instead of with the producer is a
      # green suite around a dark feature.
      refblock=",\"forkReference\":{\"height\":${STUB_READY_REFHEIGHT},\"hash\":\"${STUB_READY_REFHASH}\",\"ageSeconds\":${STUB_READY_REFAGE:-5},\"depth\":${STUB_READY_REFDEPTH:-10}}"
    fi
    for a in "$@"; do
      case "$a" in *"%{http_code}"*)
        if [ "$want_code" = "200" ] && [ "$canbuild" = "0" ]; then
          printf '{"ready":true,"reason":null,"node":{"ready":true,"canBuildTx":false%s,"shield":{"state":"unverifiable","lag":null,"reason":"no independent tip to compare against"}}%s%s%s}' "$heights" "$refs" "$refblock" "$agreeb"
        elif [ "$want_code" = "200" ]; then printf '{"ready":true,"reason":null,"node":{"ready":true,"canBuildTx":true%s}%s%s%s}' "$heights" "$refs" "$refblock" "$agreeb"
        else printf '{"ready":false,"reason":"%s","node":{"ready":false%s}%s%s%s}' "${STUB_READY_REASON:-node syncing}" "$heights" "$refs" "$refblock" "$agreeb"; fi
        printf '\n%s' "$want_code"
        exit 0 ;;
      esac
    done
    [ "$want_code" = "200" ] && exit 0 || exit 22 ;;
  *)
    exec /usr/bin/curl "$@" ;;
esac
