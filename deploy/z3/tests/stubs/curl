#!/usr/bin/env bash
# Stub curl for the export script's ready gate. STUB_READY=0 simulates a
# node that is not ready. Everything else falls through to the real curl.
echo "curl $*" >> "${STUB_LOG:?}"
case "$*" in
  *"/ready"*)
    # STUB_CURL_RC: the transport failed with this curl status (6 DNS, 7 refused, 28
    # timeout, 35 TLS handshake...), no body, no HTTP status. Only the readiness fetch,
    # so the alert and health probes in the same sweep are untouched.
    [ -n "${STUB_CURL_RC:-}" ] && exit "$STUB_CURL_RC"
    # STUB_READY_FAIL_UNTIL names a marker: fail once, then pass, which is how
    # a node lagging a couple of blocks behaves.
    if [ -n "${STUB_READY_FAIL_UNTIL:-}" ] && [ ! -e "$STUB_READY_FAIL_UNTIL" ]; then
      touch "$STUB_READY_FAIL_UNTIL"; exit 22
    fi
    # Two conventions, because two callers differ and only one was modelled here.
    # zsnap's gate uses -f, where an HTTP error is exit 22 and the body is discarded.
    # watchdog.sh now uses -sS with -w '%{http_code}', where curl exits 0 and prints
    # the body and the status, so a 503 is an ANSWER and its reason survives.
    #
    # With only the -f form modelled, the watchdog's rewrite read a READY faucet as
    # not-ready under the suite: it got exit 0 but no status to match on. That was
    # invisible because the ready-grace window is long enough that nothing paged.
    # Same gap that made redeploy-curl unable to express any of this (#229).
    want_code=200
    [ "${STUB_READY:-1}" = "1" ] || want_code=503
    # STUB_READY_SEQUENCE="0 0 1 0": readiness per CALL, one value each, the last one
    # repeating, counted in a file beside the log. For an episode that recovers and
    # relapses inside one watchdog process.
    if [ -n "${STUB_READY_SEQUENCE:-}" ]; then
      cf="${STUB_LOG}.ready-count"
      n=$(( $(cat "$cf" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$cf"
      v=1; i=0
      for x in $STUB_READY_SEQUENCE; do i=$((i + 1)); v="$x"; [ "$i" -ge "$n" ] && break; done
      if [ "$v" = "1" ]; then want_code=200; else want_code=503; fi
    fi
    # STUB_READY_CANBUILD=0: a 200 whose send gate refuses (canBuildTx:false, tip
    # unverifiable), the shape the watchdog must page on. STUB_READY_CANBUILD_ONCE names
    # a marker: refuse on the first call only, so a recovery can be observed.
    canbuild="${STUB_READY_CANBUILD:-1}"
    if [ -n "${STUB_READY_CANBUILD_ONCE:-}" ] && [ ! -e "$STUB_READY_CANBUILD_ONCE" ]; then
      touch "$STUB_READY_CANBUILD_ONCE"; canbuild=0
    fi
    # The node block's heights, for the watchdog's step 7: STUB_READY_EXTERNAL is the
    # independent tip the body carries (empty: the field is absent, as when the oracle
    # is dark); STUB_READY_EXTERNAL=zebra-est copies STUB_ZEBRA_EST, i.e. the network
    # agrees with zebra's own estimate, which is what every pre-existing stall case
    # assumed before the watchdog started asking.
    ext="${STUB_READY_EXTERNAL:-}"
    [ "$ext" = "zebra-est" ] && ext="${STUB_ZEBRA_EST:-}"
    heights=""
    [ -n "$ext" ] && heights=",\"nodeHeight\":${STUB_ZEBRA_BLOCKS:-0},\"externalHeight\":${ext}"
    # THE tipReferences BLOCK, for the watchdog's step 8 (R-12). FIVE SHAPES, and only the
    # five the app can actually produce - a stub that can express `corroborated:true` beside
    # a null `usedHeight` lets a test assert behaviour for a body that cannot exist, which
    # is worse than not covering it. STUB_READY_REFS:
    #   agree    two fresh sources 1 apart, corroborated true,  usedHeight = STUB_READY_USEDHEIGHT
    #   disagree two fresh sources far apart, corroborated false, usedHeight = the higher one
    #   single   one fresh source, corroborated NULL (one source is not agreement)
    #   none     nothing usable: sources {}, used null, usedHeight null, corroborated null
    #   absent   no tipReferences field at all, as a body from before #559 (the default)
    refs=""
    uh="${STUB_READY_USEDHEIGHT:-}"
    case "${STUB_READY_REFS:-absent}" in
      absent) refs="" ;;
      agree)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=agree needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null},\"lightwalletd\":{\"height\":$((uh - 1)),\"ageSeconds\":9,\"stale\":false,\"host\":\"lwd\"}},\"spreadBlocks\":1,\"corroborated\":true,\"used\":\"hosh\",\"usedHeight\":${uh}}" ;;
      disagree)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=disagree needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null},\"lightwalletd\":{\"height\":$((uh - 400)),\"ageSeconds\":9,\"stale\":false,\"host\":\"lwd\"}},\"spreadBlocks\":400,\"corroborated\":false,\"used\":\"hosh\",\"usedHeight\":${uh}}" ;;
      single)
        [ -n "$uh" ] || { echo "stub curl: STUB_READY_REFS=single needs STUB_READY_USEDHEIGHT" >&2; exit 64; }
        refs=",\"tipReferences\":{\"sources\":{\"hosh\":{\"height\":${uh},\"ageSeconds\":2,\"stale\":false,\"host\":null}},\"spreadBlocks\":null,\"corroborated\":null,\"used\":\"hosh\",\"usedHeight\":${uh}}" ;;
      none)
        refs=",\"tipReferences\":{\"sources\":{},\"spreadBlocks\":null,\"corroborated\":null,\"used\":null,\"usedHeight\":null}" ;;
      *) echo "stub curl: unsupported STUB_READY_REFS: ${STUB_READY_REFS}" >&2; exit 64 ;;
    esac
    for a in "$@"; do
      case "$a" in *"%{http_code}"*)
        if [ "$want_code" = "200" ] && [ "$canbuild" = "0" ]; then
          printf '{"ready":true,"reason":null,"node":{"ready":true,"canBuildTx":false%s,"shield":{"state":"unverifiable","lag":null,"reason":"no independent tip to compare against"}}%s}' "$heights" "$refs"
        elif [ "$want_code" = "200" ]; then printf '{"ready":true,"reason":null,"node":{"ready":true,"canBuildTx":true%s}%s}' "$heights" "$refs"
        else printf '{"ready":false,"reason":"%s","node":{"ready":false%s}%s}' "${STUB_READY_REASON:-node syncing}" "$heights" "$refs"; fi
        printf '\n%s' "$want_code"
        exit 0 ;;
      esac
    done
    [ "$want_code" = "200" ] && exit 0 || exit 22 ;;
  *)
    exec /usr/bin/curl "$@" ;;
esac
