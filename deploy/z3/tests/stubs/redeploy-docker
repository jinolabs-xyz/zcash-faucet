#!/usr/bin/env bash
# Stub docker for the redeploy tests. Image tags are files under
# $STUB_IMAGES holding a fake image id; compose build/up are recorded and can
# be made to fail. Everything is logged to $STUB_LOG.
set -uo pipefail
echo "docker $*" >> "${STUB_LOG:?}"
# Record the build-commit env as compose RECEIVED it. A real compose interpolates this
# into the container, so observing it here is how a test tells that redeploy computed and
# passed one rather than leaving it empty.
#
# COMPOSE ONLY. The first version logged on every docker call, including `image inspect`,
# which runs outside compose() and therefore legitimately has no such env. Those <unset>
# lines were accurate and meaningless, and they made a correct run look broken.
[ "${1:-}" = "compose" ] && \
  printf 'FAUCET_BUILD_COMMIT=%s\n' "${FAUCET_BUILD_COMMIT-<unset>}" >> "${STUB_LOG:?}"
IMG="${STUB_IMAGES:?}"

case "${1:-}" in

  image)
    # image inspect -f '{{.Id}}' <tag>
    shift; shift 2>/dev/null
    tag=""
    while [ $# -gt 0 ]; do case "$1" in -f) shift 2 ;; *) tag="$1"; shift ;; esac; done
    f="$IMG/$(printf '%s' "$tag" | tr '/:' '__')"
    [ -f "$f" ] || { echo "Error: No such image: $tag" >&2; exit 1; }
    cat "$f"
    ;;
  inspect)
    # inspect -f '{{.Image}}' <container-id>: what the RUNNING container is built from.
    # Modelled as its own fact rather than derived from the tag, because the whole point
    # of the post-condition is that those two can disagree.
    shift
    while [ $# -gt 0 ]; do case "$1" in -f) shift 2 ;; *) shift ;; esac; done
    # STUB_INSPECT_FAIL: docker answers, but not about this container. Its own state,
    # because "no container" and "cannot read the container" are different facts and the
    # script is required to treat the second as UNVERIFIED rather than as a verdict.
    # An absent .running cannot model it: a successful `up` creates one.
    [ "${STUB_INSPECT_FAIL:-0}" = "1" ] && exit 1
    if [ -f "$IMG/.running" ]; then cat "$IMG/.running"; else exit 1; fi
    ;;
  tag)
    src="$IMG/$(printf '%s' "$2" | tr '/:' '__')"
    dst="$IMG/$(printf '%s' "$3" | tr '/:' '__')"
    [ -f "$src" ] || { echo "Error: No such image: $2" >&2; exit 1; }
    cp "$src" "$dst"
    ;;
  compose)
    shift
    # `exec -T faucet node -e <script>`: the in-container probe, which is the DEFAULT
    # path because the app port is expose-only. It was not modelled at all, so every
    # no-URL behaviour was untestable and a regression that disabled auto-rollback on
    # exactly that path shipped green (#229).
    #
    #   STUB_EXEC_UNUSABLE  the probe mechanism cannot run       -> exit 1, no output
    #   STUB_EXEC_READY     file exists, the app answers ok       -> exit 0
    #   STUB_EXEC_THROW     the fetch throws, no answer at all    -> exit 3
    #   otherwise           the app answered, but not ok          -> print 503, exit 1
    if printf '%s\n' "$@" | grep -qx "exec"; then
      echo "compose exec $*" >> "${STUB_LOG:?}"
      [ -n "${STUB_EXEC_UNUSABLE:-}" ] && exit 1
      # The usability probe is the one that does NOT fetch. Detecting it by
      # grepping for process.exit(0) matched the health probe too, because
      # probe_state's script contains if(r.ok)process.exit(0), so the stub answered
      # READY to every probe_state call and the exec-path rollback test could never
      # fail. That cost three attempts at #244 and is why the test was withdrawn.
      printf '%s\n' "$@" | grep -q "fetch(" || exit 0
      [ -n "${STUB_EXEC_THROW:-}" ] && exit 3
      # health and ready need separate markers, or a test cannot express "live but not
      # ready", which is the only state the readiness gate exists to judge.
      if printf '%s\n' "$@" | grep -q '/api/health'; then
        [ -e "${STUB_EXEC_HEALTH:-${STUB_EXEC_READY:-/nonexistent}}" ] && exit 0
      else
        # STUB_EXEC_READY_MAX: ready for the first N calls only, then not. A COUNTER
        # rather than a timer, mirroring STUB_READY_MAX on the URL path. My first attempt
        # removed the marker from a background subshell after a sleep, which raced the
        # pre-deploy probe and failed intermittently: a flaky test is worse than an
        # untested path, because it teaches people to re-run until green.
        if [ -e "${STUB_EXEC_READY:-/nonexistent}" ]; then
          if [ -n "${STUB_EXEC_READY_MAX:-}" ]; then
            cf="${STUB_EXEC_READY}.count"
            n=$(( $(cat "$cf" 2>/dev/null || echo 0) + 1 ))
            echo "$n" > "$cf"
            [ "$n" -le "$STUB_EXEC_READY_MAX" ] && exit 0
          else
            exit 0
          fi
        fi
      fi
      echo 503
      exit 1
    fi
    # `compose ps -q faucet`: the container id the post-condition inspects. Silence when
    # nothing is running, which is what real compose does and how "cannot verify" is reached.
    if printf '%s\n' "$@" | grep -qx "ps"; then
      [ -f "$IMG/.running" ] && echo "stub-faucet-container"
      exit 0
    fi
    sub=""
    for a in "$@"; do case "$a" in build|up) sub="$a"; break ;; esac; done
    case "$sub" in
      build)
        if [ "${STUB_BUILD_FAIL:-0}" = "1" ]; then echo "build failed (stub)" >&2; exit 1; fi
        # A successful build produces a new image id under the live tag.
        echo "sha256:new$(date +%s%N)" > "$IMG/zcash-faucet_latest"
        echo "built" ;;
      up)
        if [ "${STUB_UP_FAIL:-0}" = "1" ]; then echo "up failed (stub)" >&2; exit 1; fi
        # STUB_UP_NO_RECREATE: compose exits 0 having decided the service is up to date,
        # so the RUNNING container keeps its old image. That is not hypothetical: it is
        # what left the wallet serving a config we had already rewritten (#278) and it is
        # invisible downstream, because the old build answers every probe perfectly.
        # Without this knob the post-condition could not be shown to fire.
        if [ "${STUB_UP_NO_RECREATE:-0}" = "1" ]; then
          echo "up: service is up-to-date (stub, did not recreate)"
          exit 0
        fi
        # Fail only the first `up`, so the new image will not start but the
        # rollback can. STUB_UP_FAIL_ONCE names the marker file.
        if [ -n "${STUB_UP_FAIL_ONCE:-}" ] && [ ! -e "$STUB_UP_FAIL_ONCE" ]; then
          touch "$STUB_UP_FAIL_ONCE"; echo "up failed (stub, first only)" >&2; exit 1
        fi
        # A real `up` makes the running container adopt whatever the live tag points at now.
        cp "$IMG/zcash-faucet_latest" "$IMG/.running" 2>/dev/null || true
        echo "started" ;;
      *) echo "stub: unsupported compose op: $*" >&2; exit 64 ;;
    esac
    ;;
  *) echo "stub docker: unsupported: $*" >&2; exit 64 ;;
esac
