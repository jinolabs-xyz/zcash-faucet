[Unit]
Description=Crosslink RPC socket for the faucet container (#409)
Documentation=file:/opt/zcash-faucet/deploy/z3/CTAZ.md
# The socket lives INSIDE the faucet's data volume, which is the only filesystem both the
# host and the container can see. Without the volume mounted there is no socket worth
# creating, and a socket on the root disk under a mountpoint that later appears would be
# invisible to the container while looking perfectly healthy from the host.
RequiresMountsFor=/var/lib/docker/volumes/zcash-faucet_faucet_data/_data

[Socket]
# The same directory ctaz-status.json is written to, which the container mounts at
# /app/data. No new host, no new port, nothing listening on any network interface.
ListenStream=/var/lib/docker/volumes/zcash-faucet_faucet_data/_data/ctaz-rpc.sock

# ONE INSTANCE PER CONNECTION. The broker then reads one request from stdin and writes
# one reply to stdout, with no server loop to leak and no shared state between callers.
# A wedged node call ties up its own instance and nothing else.
Accept=yes

# WHO MAY CONNECT, and it is one uid rather than everyone.
#
# The app is the app's `node` user since R-10 (uid 1000), not root, so root:root 0660 locks
# it out: connecting to a unix socket needs write permission on it, and a capability-dropped
# root in the container has no DAC_OVERRIDE either. Measured, both directions, in the review
# of #545: 0660 root:root is EACCES to uid 1000, 0666 connects.
#
# 0666 was the first fix and it is wider than it needs to be. It admits ANY uid on the box,
# and the argument for it was that the volume root is traversable by root alone, which is
# true of the host and not of the container, where /app/data is node-owned 0755 and any
# process in that namespace could reach it. So the group bit does the same job with a
# smaller grant: `setpriv --clear-groups` drops the app's supplementary groups but keeps
# gid 1000 as its primary, which is what the group bit matches on.
#
# Measured the same way rather than reasoned about:
#   root:1000 0660   uid 1000 connects,  uid 1002 EACCES
#   root:root 0666   uid 1000 connects,  uid 1002 CONNECTS TOO
#
# THE COST, said out loud: this pins the socket's ACL to numeric gid 1000 rather than to
# the faucet, so it narrows to "root and whatever account holds gid 1000 on this box"
# rather than to the container alone. A dedicated group cannot do the job, because
# --clear-groups means the app can only ever match on its primary gid. OPERATIONS.md
# carries the command to confirm gid 1000 is what this box thinks it is.
SocketUser=root
SocketGroup=1000
SocketMode=0660

# A stale socket file from an unclean shutdown would otherwise make the unit fail to
# start, which turns a reboot into a dark cTAZ.
RemoveOnStop=yes

# BOUNDED, because the thing on the other end is an internet-facing web app. Without this
# a burst of claims - or a loop in the app - forks broker instances until the box is out
# of pids. The faucet serialises its own sends through a queue, so a small number here is
# not a throughput ceiling in normal operation.
MaxConnections=8
MaxConnectionsPerSource=8

[Install]
WantedBy=sockets.target
