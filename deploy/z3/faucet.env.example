# Faucet env for the z3 deploy. Copy to `faucet.env` and fill in.
# `faucet.env` is gitignored, it holds secrets. Never commit it.
#
# Zallet connection is injected by the compose file (FAUCET_SENDER=zallet,
# ZALLET_RPC_URL=http://zallet:28232/). You supply the auth + account below.

# ─── Zallet RPC auth ────────────────────────────────────────────────
# Must match the [[rpc.auth]] user you added to z3's config/<net>/zallet.toml
# (see zallet-rpc-auth.example.toml).
ZALLET_RPC_USER=faucet
ZALLET_RPC_PASSWORD=

# ─── Faucet's shielded account (created inside z3's Zallet) ──────────
# Create once against the running z3 stack, then paste the results here:
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getnewaccount '"faucet"'
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getaddressforaccount '"<uuid>"'
ZALLET_ACCOUNT=
ZALLET_ADDRESS=
# Confirmations before a received note is spendable (testnet demo: 1).
ZALLET_MIN_CONF=10

# ─── Drip policy ────────────────────────────────────────────────────
FAUCET_DRIP_TAZ=0.1
FAUCET_COOLDOWN_SECONDS=86400
FAUCET_DAILY_CAP_TAZ=100
FAUCET_MIN_RESERVE_TAZ=0
SEND_QUEUE_MAX_PENDING=20

# ─── Anti-abuse ─────────────────────────────────────────────────────
# Which gate a claim has to pass: pow | turnstile | none.
#
# Declared here even though pow is now the code default, because this is the
# single most security-relevant switch we have and it was invisible to anyone
# reading deploy/ rather than src/. The live faucet ran pow only because someone
# had set it by hand, so a clean redeploy would have come up with no gate and
# nothing would have said so.
#
# pow needs a real RATE_LIMIT_SALT below: the challenge is signed with it, so a
# placeholder salt makes the gate forgeable and the app refuses to start.
FAUCET_CHALLENGE=pow

# ─── Reserve refill ─────────────────────────────────────────────────
# Whether the reserve loop may SWEEP coinbase we already own into the wallet
# (z_shieldcoinbase). This is the switch that authorises moving funds, and it is
# separate from mining on purpose (#172): shielding our own coinbase is a
# self-transfer with no fork risk, while mining on a syncing node forks us. One
# flag for both left 47.5 TAZ unswept through a shortage.
#
# Listed here EXPLICITLY, even though false is the code default, because the last
# flag that governed this appeared nowhere in deploy/ and so was invisible to
# anyone reading the deployment rather than the source. Set it to true only as a
# deliberate authorisation: with it false and a refill needed, the loop says so
# loudly every tick rather than sitting silent.
FAUCET_SHIELD_COINBASE=false

# ─── Privacy / anti-abuse ───────────────────────────────────────────
# Long random secret so hashed client IPs aren't reversible.
RATE_LIMIT_SALT=change-me-to-a-long-random-secret
# Cloudflare Turnstile (leave blank to disable). For a fully self-sovereign
# deploy, swap Turnstile for a PoW challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public receive address shown on the Donate tab (people can refill the faucet).
FAUCET_DONATION_ADDRESS=

# MAINNET unified address for donations toward running the project (server, domain,
# upkeep). This is the ONLY real-money field in this file: everything else here is
# testnet. It is validated at boot, so a testnet address pasted by mistake is logged
# and ignored rather than shown, and unset simply hides the block. Leave it empty if
# you are running your own fork.
FAUCET_MAINTENANCE_ADDRESS=

# Shown on /terms so the service has a contactable operator. Email or URL.
# Unset renders an honest 'not published' rather than an invented address, but a
# public deployment should set this.
FAUCET_CONTACT=

# Who operates this deployment, and their site. A fork sets its own.
FAUCET_OPERATOR=Jino Labs
FAUCET_OPERATOR_URL=https://jinolabs.xyz

# Light client (Zaino) endpoint, used ONLY for the read-side lookups on the site
# (/api/balance, /api/network). Sending goes through Zallet, not this. Default is
# a public Zaino, so there's nothing to run.
#
# SELF-HOSTING THIS IS NOT A CONFIG SWAP, and this comment used to read as though it
# were. SDE-App reasonably took it that way an hour before a public post and asked for
# the endpoint to be repointed. Three things have to happen first:
#
#   1. z3 keeps zaino behind a compose PROFILE (`profiles: [indexer]` in its
#      docker-compose.yml), so there is no container to talk to until that profile is
#      started. Repointing alone aims the app at nothing and /api/balance and
#      /api/network start failing.
#   2. Z3_ZAINO_IMAGE is UNPINNED in stack-versions.env, so starting the indexer
#      inherits whatever tag upstream defaults to, with no version review by us.
#      audit-drift.sh correctly reports that as NOT VERIFIED the moment it runs.
#   3. Then verify /api/balance and /api/network still answer against it, because
#      "the container started" is not "the app can read from it".
#
# So: a deploy, plus a version review in a PR, plus a verification. Not a line swap.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443
# LIGHTWALLETD_ENDPOINT=http://zaino:8137   # self-hosted z3 Zaino, after the three steps above

# WHAT THIS ENDPOINT IS AND IS NOT USED FOR, because the distinction is the honest
# version of "no third party". Sending never touches it: a drip is built and broadcast
# by our own Zallet against our own Zebra, so nobody else can move the funds. This
# serves read-only lookups, /api/balance and /api/network.
#
# HOSH_URL below is a third party TOO, and that one is deliberate rather than a
# compromise: a node cannot tell you it has fallen behind the network, because a node
# far behind and a node at the tip both report their own tip with equal confidence.
# Same for the chain-identity comparison, which asks an independent source for a block
# hash at a common height. Asking our own node would be asking the suspect for an alibi.

# ─── Switches the app reads that used to live only in the source ─────
# Written down because a key the deployment never mentions is invisible to
# anyone reading deploy/ rather than src/. FAUCET_MINER_ACTIVE being absent
# here is how 47.5 TAZ sat unswept through a shortage (#172), and
# audit-drift now reports any recurrence.

# Anti-abuse mode: pow | turnstile | none. Production runs pow.
FAUCET_CHALLENGE=pow

# How long a client's attempts are remembered for PoW escalation. Declared, not
# left to the code default, because it is the lever that targets farming rather
# than taxing everyone: at ten minutes a farmer pacing one attempt every eleven
# reset escalation forever and paid base difficulty (#209).
FAUCET_POW_WINDOW_SECONDS=3600

# Claims per /24 per day. The subnet is the unit a farmer cannot cheaply spread
# across, unlike addresses (#214).
FAUCET_SUBNET_DAILY_MAX=20

# Whether we may MINE. The app never mines itself (that is the miner container
# and zebra); this only arms the reserve loop to OBSERVE. It does NOT authorise
# moving funds. Shielding coinbase is a separate switch, deliberately.
FAUCET_MINER_ACTIVE=false

# Where the miner writes its heartbeat, which is how /api/status learns what the
# miner is actually DOING rather than what this file configured. FAUCET_MINER_ACTIVE
# above is intent and cannot be false while the miner is broken: it read "on" for 70
# minutes while the miner errored every 5 seconds on a stale auth cookie.
#
# Bind-mount the miner's state directory READ-ONLY. The faucet must not be able to
# write the signal it is judging. Contract: deploy/z3/MINER-HEARTBEAT.md.
#
# Leave it UNSET and the panel says "cannot tell" rather than claiming the miner is
# off, which is the honest answer and the reason there is no default path here.
FAUCET_MINER_HEARTBEAT_PATH=/var/lib/faucet-miner/heartbeat.json

# Transparent address the miner pays coinbase to. Validated at boot since a
# wrong one sends every block reward somewhere unrecoverable (#156).
FAUCET_MINING_ADDRESS=

# ─── Reserve loop ────────────────────────────────────────────────────
# Refill stops at target, starts below low. Checked at boot that low < target.
FAUCET_RESERVE_TARGET_TAZ=15
FAUCET_RESERVE_LOW_TAZ=5
FAUCET_RESERVE_CHECK_SECONDS=30

# ─── Chain-freshness gates (#171/#172) ───────────────────────────────
# These three are parsed with a THROWING parser: a value that is not a number
# refuses to boot rather than becoming NaN, because `x > NaN` is false and a NaN
# threshold does not loosen a guard, it removes it. Worth knowing from the audit
# rather than from a dead box.

# How far our node may lag the independently-observed tip and still be trusted to
# BUILD a transaction. Zcash sets expiry at tip+40, so a 40-block lag produces
# transactions that are dead on arrival, and that is what stranded a 1.2501 TAZ
# shield and crash-looped the wallet (#172). 40 is the cliff, not the target;
# values above 10 are clamped in code, and lower is always allowed.
FAUCET_SHIELD_MAX_LAG_BLOCKS=5

# How far behind the network before readiness calls our node frozen and stops
# serving. Much looser than the shield budget on purpose: these answer different
# questions, and sharing one number is what let a fatal 40-block lag read healthy.
FAUCET_FREEZE_BLOCKS=200

# How long our own tip may sit unchanged before we call it stalled, independent of
# any external source, so the signal still works when the oracle is down.
# Suppressed when the external tip is also static (a quiet network is not our fault).
FAUCET_TIP_STALL_MS=1200000

# Where the independent tip comes from. The integration suite overrides this with a
# local fixture; leaving it unset uses the public dashboard.
HOSH_URL=https://hosh.zec.rocks/api/v0/zec.json

# Explorer link template shown beside a drip receipt. {txid} is substituted.
FAUCET_EXPLORER_TX_URL=https://testnet.cipherscan.app/tx/{txid}
