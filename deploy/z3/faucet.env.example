# Faucet env for the z3 deploy. Copy to `faucet.env` and fill in.
# `faucet.env` is gitignored — it holds secrets. Never commit it.
#
# Zallet connection is injected by the compose file (FAUCET_SENDER=zallet,
# ZALLET_RPC_URL=http://zallet:28232/). You supply the auth + account below.

# ─── Zallet RPC auth ────────────────────────────────────────────────
# Must match the [[rpc.auth]] user you added to z3's config/<net>/zallet.toml
# (see zallet-rpc-auth.example.toml).
ZALLET_RPC_USER=faucet
ZALLET_RPC_PASSWORD=

# ─── Faucet's shielded account (created inside z3's Zallet) ──────────
# Create once against the running z3 stack, then paste the results here:
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getnewaccount '"faucet"'
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getaddressforaccount '"<uuid>"'
ZALLET_ACCOUNT=
ZALLET_ADDRESS=
# Confirmations before a received note is spendable (testnet demo: 1).
ZALLET_MIN_CONF=10

# ─── Drip policy ────────────────────────────────────────────────────
FAUCET_DRIP_TAZ=0.1
FAUCET_COOLDOWN_SECONDS=86400
FAUCET_DAILY_CAP_TAZ=100
FAUCET_MIN_RESERVE_TAZ=0
SEND_QUEUE_MAX_PENDING=20

# ─── Privacy / anti-abuse ───────────────────────────────────────────
# Long random secret so hashed client IPs aren't reversible.
RATE_LIMIT_SALT=change-me-to-a-long-random-secret
# Cloudflare Turnstile (leave blank to disable). For a fully self-sovereign
# deploy, swap Turnstile for a PoW challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public receive address shown on the Donate tab (people can refill the faucet).
FAUCET_DONATION_ADDRESS=

# Light client (Zaino) endpoint — used ONLY for the read-side lookups on the site
# (/api/balance, /api/network). Sending goes through Zallet, not this. Default is
# a public Zaino, so there's nothing to run. To self-host instead, start z3's
# indexer (`--profile indexer`) and swap the line for the commented one below.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443
# LIGHTWALLETD_ENDPOINT=http://zaino:8137   # self-hosted z3 Zaino, over the shared network
