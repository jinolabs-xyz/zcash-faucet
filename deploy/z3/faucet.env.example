# Faucet env for the z3 deploy. Copy to `faucet.env` and fill in.
# `faucet.env` is gitignored — it holds secrets. Never commit it.
#
# Zallet connection is injected by the compose file (FAUCET_SENDER=zallet,
# ZALLET_RPC_URL=http://zallet:28232/). You supply the auth + account below.

# ─── Zallet RPC auth ────────────────────────────────────────────────
# Must match the [[rpc.auth]] user you added to z3's config/<net>/zallet.toml
# (see zallet-rpc-auth.example.toml).
ZALLET_RPC_USER=faucet
ZALLET_RPC_PASSWORD=

# ─── Faucet's shielded account (created inside z3's Zallet) ──────────
# Create once against the running z3 stack, then paste the results here:
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getnewaccount '"faucet"'
#   docker compose --env-file .env.testnet exec zallet \
#     zallet-zaino -d /var/lib/zallet rpc z_getaddressforaccount '"<uuid>"'
ZALLET_ACCOUNT=
ZALLET_ADDRESS=
# Confirmations before a received note is spendable (testnet demo: 1).
ZALLET_MIN_CONF=10

# ─── Drip policy ────────────────────────────────────────────────────
FAUCET_DRIP_TAZ=0.1
FAUCET_COOLDOWN_SECONDS=86400
FAUCET_DAILY_CAP_TAZ=100
FAUCET_MIN_RESERVE_TAZ=0
SEND_QUEUE_MAX_PENDING=20

# ─── Reserve refill ─────────────────────────────────────────────────
# Whether the reserve loop may SWEEP coinbase we already own into the wallet
# (z_shieldcoinbase). This is the switch that authorises moving funds, and it is
# separate from mining on purpose (#172): shielding our own coinbase is a
# self-transfer with no fork risk, while mining on a syncing node forks us. One
# flag for both left 47.5 TAZ unswept through a shortage.
#
# Listed here EXPLICITLY, even though false is the code default, because the last
# flag that governed this appeared nowhere in deploy/ and so was invisible to
# anyone reading the deployment rather than the source. Set it to true only as a
# deliberate authorisation: with it false and a refill needed, the loop says so
# loudly every tick rather than sitting silent.
FAUCET_SHIELD_COINBASE=false

# ─── Privacy / anti-abuse ───────────────────────────────────────────
# Long random secret so hashed client IPs aren't reversible.
RATE_LIMIT_SALT=change-me-to-a-long-random-secret
# Cloudflare Turnstile (leave blank to disable). For a fully self-sovereign
# deploy, swap Turnstile for a PoW challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public receive address shown on the Donate tab (people can refill the faucet).
FAUCET_DONATION_ADDRESS=

# Light client (Zaino) endpoint — used ONLY for the read-side lookups on the site
# (/api/balance, /api/network). Sending goes through Zallet, not this. Default is
# a public Zaino, so there's nothing to run. To self-host instead, start z3's
# indexer (`--profile indexer`) and swap the line for the commented one below.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443
# LIGHTWALLETD_ENDPOINT=http://zaino:8137   # self-hosted z3 Zaino, over the shared network

# ─── Switches the app reads that used to live only in the source ─────
# Written down because a key the deployment never mentions is invisible to
# anyone reading deploy/ rather than src/. FAUCET_MINER_ACTIVE being absent
# here is how 47.5 TAZ sat unswept through a shortage (#172), and
# audit-drift now reports any recurrence.

# Anti-abuse mode: pow | turnstile | none. Production runs pow.
FAUCET_CHALLENGE=pow

# Whether we may MINE. The app never mines itself (that is the miner container
# and zebra); this only arms the reserve loop to OBSERVE. It does NOT authorise
# moving funds — shielding coinbase is a separate switch, deliberately.
FAUCET_MINER_ACTIVE=false

# Transparent address the miner pays coinbase to. Validated at boot since a
# wrong one sends every block reward somewhere unrecoverable (#156).
FAUCET_MINING_ADDRESS=

# ─── Reserve loop ────────────────────────────────────────────────────
# Refill stops at target, starts below low. Checked at boot that low < target.
FAUCET_RESERVE_TARGET_TAZ=15
FAUCET_RESERVE_LOW_TAZ=5
FAUCET_RESERVE_CHECK_SECONDS=30
