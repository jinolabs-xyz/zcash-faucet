# Reverse proxy + automatic HTTPS for the faucet.
#
# FAUCET_DOMAIN is injected by the compose file:
#   - a real hostname (faucet.example.org) → Caddy provisions a Let's Encrypt
#     certificate on first request and redirects HTTP to HTTPS itself.
#   - ":80" → plain HTTP on port 80, for a quick localhost / IP smoke test.
#
# Caddy sets X-Forwarded-For for the upstream; the app trusts exactly one hop
# (TRUSTED_PROXY_COUNT=1) so per-IP rate limiting sees the real client IP.
#
# See HTTPS.md for DNS, firewall and troubleshooting.
{
	# The admin API needs no listener on a single-box public deploy, and
	# leaving it off removes a config-rewrite surface from the container.
	admin off
	# Certificate expiry notices go nowhere by default: Let's Encrypt accepts
	# an account with no contact, and a fake address is worse than none. To
	# get them, add a real one here:  email you@example.org
}

{$FAUCET_DOMAIN} {
	encode zstd gzip

	header {
		# Once a browser has seen this over HTTPS it refuses plain HTTP for
		# the domain. Ignored over HTTP, so the :80 smoke test is unaffected.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here is meant to be embedded, and a framed faucet is a
		# clickjacking surface for the claim button.
		X-Frame-Options "DENY"
		# Don't advertise the proxy version to scanners.
		-Server
	}

	# CHAIN SNAPSHOTS, so a rebuilt box downloads instead of syncing from genesis (#7).
	#
	# Served from the box we already pay for. The alternatives all cost money for a file
	# that is public chain data: object storage is a bill, and GitHub Releases caps assets
	# at 2 GB against an 8.5 GB archive.
	#
	# THE BANDWIDTH MATH, because this is the one thing here that can turn into a charge.
	# Measured 45 GB egress in 10 days (~135 GB/month) against Linode's ~1 TB included
	# transfer, and each download is 8.5 GB. So roughly 100 downloads a month fit in the
	# headroom. That is ample for disaster recovery and nowhere near enough to survive
	# being treated as a public mirror, which is why there is no directory listing: you
	# need the pointer file to know what to ask for.
	handle /snapshots/* {
		root * /srv
		# No `browse`. A listing invites crawlers to walk 8.5 GB files, and the pointer
		# below is the supported way in.
		file_server
		header {
			# The archives are content-addressed by the hash in their filename, so a name
			# never means two different files and a long cache is safe. latest-*.txt is the
			# mutable one and gets no-cache, or a rebuild follows a stale pointer to an
			# archive rotation has already deleted.
			Cache-Control "public, max-age=604800, immutable"
		}
	}
	@snapshot_pointer path /snapshots/latest-*.txt
	header @snapshot_pointer Cache-Control "no-cache"

	reverse_proxy faucet:3000

	# Access logs to stdout so they land in the same docker logging pipeline
	# as the rest of the stack. The health and readiness probes are most of
	# the traffic and say nothing, so they stay out of it.
	@health path /api/health /api/ready
	log_skip @health
	log {
		output stdout
		format console
	}
}
