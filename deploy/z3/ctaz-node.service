# The Crosslink (cTAZ) node, contained so it cannot hurt the TAZ faucet.
#
# Part of #327. Every limit here comes from something observed in the spike rather than
# from a general instinct about hardening, and the comments say which.
#
# Install (the volume must be mounted and in fstab with nofail first, see CTAZ.md):
#   useradd --system --home-dir /mnt/ctaz-chain/node --shell /usr/sbin/nologin ctaz
#   install -d -o ctaz -g ctaz /mnt/ctaz-chain/node
#   ln -sfn /mnt/ctaz-chain/node /var/lib/ctaz-node        # convenience alias only
#   cp ctaz-zebrad /opt/faucet/ctaz-zebrad && chmod +x /opt/faucet/ctaz-zebrad
#   cp ctaz-node.service /etc/systemd/system/
#   # config in /etc/faucet/ctaz-zebrad.toml  (see CTAZ.md for the required keys)
#   systemctl daemon-reload && systemctl enable --now ctaz-node
#
# ── WHAT THIS UNIT DELIBERATELY DOES NOT CLAIM TO FIX ────────────────────────────
#
# #327 asks the unit to replace their hardcoded ten-second sleep with explicit startup
# ordering. IT CANNOT, and pretending otherwise would be the more dangerous outcome.
# Their zaino runs INSIDE zebrad: start.rs:719 awaits `spawn_indexer(...)` in the same
# process, and the sleep is zaino waiting for zebra's state to be ready across a function
# call, not across a service boundary. systemd orders processes; it has nothing to order
# here. Running zaino as its own service would give us that boundary, but standalone
# `zainod` does not compile from their monorepo, so embedded is the only option today.
#
# What the unit CAN do, and does below, is stop anything DOWNSTREAM from believing this
# node is usable before it actually is. That is a different guarantee and it is the one
# available.

[Unit]
Description=Crosslink feature-net node (cTAZ), contained
Documentation=file:/opt/zcash-faucet/deploy/z3/CTAZ.md
After=network-online.target
Wants=network-online.target

# ── THE STATE LIVES ON A DEDICATED VOLUME, AND THIS LINE IS WHY THAT IS SAFE ─────
# The chain state is on a separate block device mounted at /mnt/ctaz-chain, so cTAZ
# growth cannot squeeze the disk the TAZ faucet runs on.
#
# The pathing has one trap and this line is the answer to it. If the volume is ever
# detached, /mnt/ctaz-chain is still a perfectly good empty directory on the ROOT
# disk, so a node pointed there would start happily and sync the whole chain onto
# the disk it was moved off to protect. That is not hypothetical: a full root disk
# is what took the faucet down on 2026-08-03. RequiresMountsFor pulls in the .mount
# unit and fails the start if it is not there, so a detached volume stops the node
# instead of silently redirecting it.
RequiresMountsFor=/mnt/ctaz-chain

# OnFailure IS WIRED, and #327's "best-effort tier" is NOT yet honoured. Read this before
# assuming the tiering exists.
#
# My first draft omitted OnFailure on purpose, reasoning that a feature-net stall must not
# page like a TAZ outage. The repo's own rule caught it: repo.sh asserts every service
# routes its failures somewhere, and to the template this repo actually ships. That rule
# exists because App found a service with no handler at all, and it is right.
#
# Omitting the handler does not buy a quieter tier, it buys SILENCE, and silence is the
# worse failure of the two: a noisy page is recoverable, a node that failed and told
# nobody is the thing this whole stack was built to stop.
#
# So failures route here like everything else, and the honest consequence is that a cTAZ
# failure currently pages exactly like a TAZ one. alert.sh has NO severity tiering today
# (checked: no severity, tier or urgency handling in it), so there is nothing to route a
# best-effort alert to. Building that tiering is the remaining part of #327's watchdog
# item and it is not done here. Do not read this line as the tier existing.
OnFailure=faucet-alert@%n.service

[Service]
Type=simple
User=ctaz
Group=ctaz

# The datadir is named in full rather than through StateDirectory=. StateDirectory
# creates and chowns a path under /var/lib, which is the disk we are deliberately
# keeping this chain off; /var/lib/ctaz-node is left as a symlink to the real path
# for anyone who goes looking there, but nothing in this unit depends on it.
#
# ProtectSystem=strict below mounts the whole hierarchy read-only, /mnt included, so
# the datadir has to be punched back through as writable explicitly. Without this the
# node starts and then fails on its first write, which reads like a corrupt volume.
#
# Their node makes its own chain-name subdirectory underneath, which is where the
# state actually lands:
#   /mnt/ctaz-chain/node/<chain-name>/state/v27/unknowntestnet
#   /mnt/ctaz-chain/node/<chain-name>/zaino/local   <- the indexer db lives in the tree too
Environment=CTAZ_DATADIR=/mnt/ctaz-chain/node
ReadWritePaths=/mnt/ctaz-chain/node

# ── REFUSE TO START ON A PORT COLLISION ──────────────────────────────────────────
# A crosslink node derives four listeners from one config value (P-1, P, P+10000,
# P+10001). Two of them are ten thousand ports from the number in the config, and the
# dangerous one is zaino's JSON-RPC at P+10000: with their default base that lands on
# 18233, which is our zebra P2P port. Checking at start time rather than trusting whoever
# edited the toml, because the failure mode is stealing a port from the TAZ node.
#
# THE `+` IS LOAD-BEARING: it runs this one check as root, outside the sandbox. Seeing
# every listener on the box is inherently privileged, and `lsof` run as ctaz exits 1 with
# nothing on stderr, so the check reported CANNOT-VERIFY and the node refused to start.
# The guard was right to refuse; a port check that can only see its own user's sockets
# cannot answer the question it exists to answer. The script is read-only, so the cost of
# the privilege is bounded.
ExecStartPre=+/opt/faucet/ctaz-port-check.sh ${CTAZ_BASE_PORT}

# ── REFUSE TO START IF THE DATADIR IS ALREADY OVER ITS CEILING ───────────────────
# This is still NOT a quota: nothing here stops a RUNNING node from growing. What has
# changed since it was written is what happens when it does. The dedicated volume is now
# the real ceiling, so unbounded growth fills 59 GB of storage that holds nothing else
# and the TAZ faucet does not notice. The guard's job shrank accordingly, from the only
# line of defence to an early warning: it refuses to restart a node whose state has
# already passed the tripwire, so we hear about it with room to act.
#
# The number matters more here than usual. Measured growth on this chain was 20.8 KB/block
# at height 428, 29.8 at 1.6k and 66.1 at 22k, so per-block cost RISES with height and
# every early extrapolation understates. Until the sync reaches the tip and the real
# figure is known, the ceiling is a guess with a safety margin, set in ctaz.env below the
# volume size rather than at it.
ExecStartPre=/opt/faucet/ctaz-datadir-guard.sh ${CTAZ_DATADIR} ${CTAZ_MAX_STATE_GB}

# These are FALLBACKS, not the settings. /etc/faucet/ctaz.env is the operator's
# declaration and it wins: EnvironmentFile= overrides Environment= no matter which order
# they appear in, which is worth stating because reading top-to-bottom suggests the
# opposite. Verified on this box rather than taken from the man page (systemd 255, a
# oneshot echoing the variable with the file setting 45 and Environment= setting 14
# printed 45), because a fallback that silently won would cap the ceiling at 14 GB on a
# 59 GB volume and look like the guard misfiring.
#
# The fallbacks stay deliberately small. If ctaz.env is ever missing, we know nothing
# about the storage this node landed on, and refusing to start too early is recoverable
# in a way that filling a disk is not.
EnvironmentFile=-/etc/faucet/ctaz.env
Environment=CTAZ_BASE_PORT=19233
Environment=CTAZ_MAX_STATE_GB=14

ExecStart=/opt/faucet/ctaz-zebrad -c /etc/faucet/ctaz-zebrad.toml start

# ── THE TAZ SIDE ALWAYS WINS ─────────────────────────────────────────────────────
# The miner already runs at CPUQuota=150%, Nice=15, IOSchedulingClass=idle, and #327 asks
# for this to sit below even that. `idle` is already the lowest IO class, so the only room
# left is the priority within it and a deeper nice. Being honest about the ceiling: on a
# contended box the difference between idle/4 and idle/7 is small, and if cTAZ ever
# genuinely starves the miner the answer is fewer cores here, not a lower priority number.
CPUQuota=100%
Nice=19

# IO is best-effort/7, NOT idle, and the volume is the reason. `idle` was right when this
# chain shared a spindle with the TAZ node: yield, always. The state now lives on its own
# block device with nothing else on it, so idle priority is not yielding to anything, it
# is just refusing to use a device we are paying for. Nice=19 and CPUQuota still handle
# the resource that IS shared, which is the CPU.
#
# If cTAZ state ever moves back onto the root disk, this must go back to idle.
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Their node holds the chain state plus zaino's cache in one process. This cap exists so a
# leak trips a cgroup kill on THIS service rather than the OOM killer choosing zebra or
# zallet, which is the outcome that takes the faucet down.
# 3G, AND THIS IS THE FIRST TIME THIS NUMBER HAS BEEN MEASURED RATHER THAN GUESSED.
#
# 2G was a guess made before the node had ever run. At tip, with the sync concurrency
# bounded (#370), it settles at 2.2-2.3 GB and stays there: flat for half an hour, zero
# restarts, zero hits against the ceiling. 2G is BELOW the steady state, so it is not a
# safety margin, it is a guaranteed kill.
#
# THIS IS NOT #363 AGAIN. That raise chased a number we did not understand, which is why
# #370 said the next move must be to bound the demand instead. The demand is now bounded
# and observed. Setting the ceiling from the observation is the opposite move.
#
# WHY IT MATTERED URGENTLY: the documented miner-on step removes the initial-sync drop-in,
# and that drop-in was the only thing holding 3G. Following our own procedure would have
# dropped the cap under the live usage and killed the node at the moment we turned it on,
# which is the worst possible time to discover it.
MemoryMax=3G
MemorySwapMax=0

# Best-effort and long-running: come back, but slowly enough that a misconfigured node
# cannot spin. Deliberately on-failure and not always, so a clean administrative stop
# stays stopped.
Restart=on-failure
RestartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
