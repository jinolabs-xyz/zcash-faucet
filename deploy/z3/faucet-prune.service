# Reclaims Docker build cache and unreferenced images. See prune.sh for what it
# will never touch (volumes, containers, the rollback image, anything in use).
[Unit]
Description=Faucet Docker disk prune
Documentation=file:/opt/zcash-faucet/deploy/z3/prune.sh
After=docker.service
Wants=docker.service
OnFailure=faucet-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/faucet/prune.env
ExecStart=/opt/faucet/prune.sh
# Deleting 50 GB of layers is I/O; the node's disk comes first.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
