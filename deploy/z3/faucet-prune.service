# Reclaims Docker build cache and dangling layers. See prune.sh for what it will
# never touch (volumes, containers, any tagged image).
[Unit]
Description=Faucet Docker disk prune
Documentation=file:/opt/zcash-faucet/deploy/z3/prune.sh
After=docker.service
Wants=docker.service
OnFailure=faucet-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/faucet/prune.env
ExecStart=/opt/faucet/prune.sh

[Install]
WantedBy=multi-user.target
