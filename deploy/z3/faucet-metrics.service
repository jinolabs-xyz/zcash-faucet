# Writes the faucet's Prometheus textfile. See faucet-metrics.sh and
# OBSERVABILITY.md.
# Install:
#   cp faucet-metrics.sh /opt/faucet/ && chmod +x /opt/faucet/faucet-metrics.sh
#   cp faucet-metrics.service faucet-metrics.timer /etc/systemd/system/
#   # optional: METRICS_FILE, METRICS_FAUCET_URL in /etc/faucet/metrics.env
#   systemctl daemon-reload && systemctl enable --now faucet-metrics.timer
[Unit]
Description=Faucet metrics textfile
After=docker.service
Wants=docker.service
OnFailure=faucet-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/faucet/metrics.env
# The script also READS /etc/faucet/watchdog.env itself for anything metrics.env does not
# set: the probe URL and the container matches are the watchdog's, so there is one place
# to keep them right rather than two that drift.
#
# NOT AS A SECOND EnvironmentFile=. That was here so `systemctl cat` would show both files,
# on the belief it was inert. It is not: systemd loads every WATCHDOG_* value into this
# process and every child it runs, and watchdog.env holds the alert webhook, which is a
# credential. The script reads the file under `env -i` instead, so the values reach
# nothing but the two variables that need them.
ExecStart=/opt/faucet/faucet-metrics.sh
# Two HTTP calls and a couple of docker inspects. It must never be the
# reason the node is slow.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
