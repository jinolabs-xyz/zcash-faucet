# Supervises the z3 faucet stack. See watchdog.sh for what it does.
# Install:
#   cp watchdog.sh /opt/faucet/watchdog.sh && chmod +x /opt/faucet/watchdog.sh
#   cp faucet-watchdog.service /etc/systemd/system/
#   # optional: put WATCHDOG_ALERT_URL=... etc in /etc/faucet/watchdog.env
#   systemctl daemon-reload && systemctl enable --now faucet-watchdog
[Unit]
Description=Zcash faucet stack watchdog (self-healing supervision)
After=docker.service
Requires=docker.service
OnFailure=faucet-alert@%n.service
# NEVER GIVE UP ON THIS SERVICE. 0 DISABLES start rate limiting, so no number of
# rapid restarts can make systemd stop trying. That is the intent for a watchdog:
# the thing that notices other things are broken must not be the thing that quietly
# stays dead.
#
# It lives in [Unit], not [Service], and that is not a style choice. systemd parses
# it here and nowhere else, confirmed rather than looked up:
#
#   [Service]  systemd-analyze verify -> Unknown key name 'StartLimitIntervalSec'
#                                        in section 'Service', ignoring.
#   [Unit]     systemd-analyze verify -> no complaint
#
# The comment that used to sit beside it in [Service] said "don't let a bad loop
# hammer the box", which describes the OPPOSITE of what 0 does, attached to a line
# systemd was discarding. A protection claimed twice over and delivered neither time.
StartLimitIntervalSec=0

[Service]
Type=simple
# Optional overrides (WATCHDOG_ALERT_URL, WATCHDOG_INTERVAL, container matches).
# The '-' means it is fine if the file does not exist.
EnvironmentFile=-/etc/faucet/watchdog.env
ExecStart=/opt/faucet/watchdog.sh
# The watchdog must itself never stay down. Bring it back on any exit.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
