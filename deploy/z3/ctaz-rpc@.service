[Unit]
Description=One Crosslink RPC call from the faucet container (#409)
Documentation=file:/opt/zcash-faucet/deploy/z3/CTAZ.md
# Instance-per-connection, started by ctaz-rpc.socket. Never enabled directly: the socket
# is what is enabled, and systemd instantiates this on each accept.
#
# ROUTES ITS FAILURES LIKE EVERY OTHER SERVICE, and the repo suite caught that this was
# missing rather than a reviewer. The rule's one exemption is faucet-alert@.service, which
# is exempt because pointing the handler at itself is a loop; nothing about being a
# template exempts this one.
#
# It is not noisy, because the broker EXITS 0 on every failure it handles - bad JSON, a
# refused method, a node that will not answer are all answers it returns down the socket.
# Reaching this handler means the broker itself died or hit the backstop below, which is
# rare and worth someone knowing about.
OnFailure=faucet-alert@%n.service

[Service]
Type=simple
ExecStart=/opt/faucet/ctaz-rpc-broker.sh
# Accept=yes hands the connection in on stdin. Explicit rather than inherited, because a
# broker whose stdin is not the socket reads EOF, answers nothing, and looks to the
# caller exactly like a node that is down.
StandardInput=socket
StandardOutput=socket
# Errors go to the journal, NOT down the socket, so a refusal reaches an operator without
# also handing the caller a stack trace.
StandardError=journal

EnvironmentFile=-/etc/faucet/ctaz.env

# NOT the ctaz user. This process talks to the node's loopback RPC and does not touch the
# chain state, so it gets its own minimal footprint instead of the node's privileges.
DynamicUser=yes
# The socket is root:root 0660 and systemd hands the connection in already accepted, so
# the broker never opens it itself and needs no access to the volume at all.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# One call is a request and a reply. Anything longer is a wedged node, and the broker's
# own timeout (80s) should have fired first - this is the backstop for the case where it
# did not, so a stuck instance cannot hold a connection slot forever. The ladder is
# client 75s < broker 80s < unit 100s, each layer outliving the one that talks to it,
# so a timeout always fires at the layer that can name the cause.
TimeoutStartSec=100
RuntimeMaxSec=100

MemoryMax=64M
CPUQuota=25%
