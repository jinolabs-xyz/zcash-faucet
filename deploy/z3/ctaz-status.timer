[Unit]
Description=Refresh the Crosslink node status file

[Timer]
# Every 30s, and the number is still tied to the reader rather than chosen for feel.
# statusFile.ts calls a file stale after 3 minutes. At one run a minute that is THREE
# attempts inside the window, and the node answers about 64% of the time while mining, so
# three consecutive misses happen roughly 1 run in 20 - which is exactly what put the panel
# into `readiness: stale` with a perfectly good 100%-synced reading sitting in the file.
#
# MEASURED, not modelled: 9 wrote, 5 kept, 0 failures-written in fifteen minutes, and the
# file still went 180s without a successful write. The keep-last-good change (#397) stopped
# a failure CLOBBERING good data; it cannot stop a run of failures aging it out.
#
# At 30s there are six attempts per window and the same miss rate puts a full window of
# failures near 1 in 500. The script is a couple of curls and a python parse, so the cost
# of doubling it is noise next to a miner using 250%.
#
# If the reader's window ever changes, change this with it: the relationship is the point,
# not the number.
OnBootSec=90s
OnUnitActiveSec=30s
AccuracySec=10s

[Install]
WantedBy=timers.target
