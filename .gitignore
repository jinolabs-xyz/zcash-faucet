# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# data (sqlite lives here)
/data/*.db
/data/*.db-*

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
# ...except two test fixtures. `scripts/live-probe.test.mjs` needs a genuinely EXPIRED
# certificate to prove the probe tells "already expired" apart from "nothing is
# listening" - tls.connect verifies by default, so an expired certificate fails the
# handshake and never reaches the days-left branch. Generating one needs
# `openssl req -not_before/-not_after`, which did not exist before OpenSSL 3.5, and
# ubuntu-latest, node:22 and this repo's harness all ship 3.0.x - so the test skipped on
# every machine that runs the gate. The key is a throwaway for localhost, expired in 2020
# before it was committed, and secures nothing. See scripts/fixtures/README.md.
!scripts/fixtures/expired-localhost.crt.pem
!scripts/fixtures/expired-localhost.key.pem
npm-debug.log*
next-env.d.ts
tsconfig.tsbuildinfo

# local editor / harness config
.claude/

# faucet wallet secret - NEVER commit
.faucet-wallet.local

# deploy secrets + generated artifacts - NEVER commit (keep the .example templates)
deploy/**/faucet.env
# Every suffix too. faucet.env.bak.<epoch> backups sat untracked in the production
# checkout, which is what put -untracked on the deployed build commit and what let one
# into the image context. Untracked is not ignored: git status showed them, nothing read it.
deploy/**/faucet.env.*
deploy/**/*.env.*
deploy/**/*.env~
deploy/**/#*.env#
!deploy/**/faucet.env.example
deploy/**/.env
deploy/z3-stack/
deploy/.zallet-rpc-password
deploy/.faucet-account

# Fixtures written by scripts/ui-state.mjs to drive the UI into a named state.
# Regenerated on every run and never meant to be shared.
/.ui-state/

# Local scripts that reach the production box. They carry no secrets, but they carry the
# BOX ADDRESS and the user it is reached as, and this repo is public. That has been removed
# by hand twice already - #95 "stop pinning the box IP in an example" and #250 "use
# placeholders in ops examples and test fixtures" - and came back both times because these
# files sit in the tree untracked and unignored, where one `git add -A` sweeps them up.
#
# An address in git history is not removed by deleting it later. If a dev script is worth
# sharing, commit it deliberately with the host taken from the environment and add a `!` line
# here saying so.
/scripts/dev-*.sh
