{
  "name": "zcash-testnet-faucet",
  "version": "0.1.0",
  "private": true,
  "description": "Zcash testnet (TAZ) faucet \u2014 Next.js + public lightwalletd backend, Z3-era stack (zcashd is EOL).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/e2e-smoke.mjs",
    "test:api": "node scripts/api-integration.mjs",
    "smoke:live": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/live-probe.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@bitgo/utxo-lib": "^11.24.1",
    "@d4mr/t2z-wasm": "^0.0.2",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@scure/base": "^2.2.0",
    "better-sqlite3": "^11.8.1",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8"
  }
}
